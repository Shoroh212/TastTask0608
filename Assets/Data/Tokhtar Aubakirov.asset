  m_Script: {fileID: 11500000, guid: c18a09a6f4a745c4f98a5e972119e6a5, type: 3}
  m_Name: Tokhtar Aubakirov
  m_EditorClassIdentifier: Assembly-CSharp::Information
  text: "\u0422\u043E\u043A\u0442\u0430\u0440 \u0410\u0443\u0431\u0430\u043A\u0438\u0440\u043E\u0432
    \u2014 \u043F\u0435\u0440\u0432\u044B\u0439 \u043A\u043E\u0441\u043C\u043E\u043D\u0430\u0432\u0442
    \u043D\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0433\u043E \u041A\u0430\u0437\u0430\u0445\u0441\u0442\u0430\u043D\u0430,
    \u043B\u0451\u0442\u0447\u0438\u043A-\u0438\u0441\u043F\u044B\u0442\u0430\u0442\u0435\u043B\u044C
    \u0438 \u0413\u0435\u0440\u043E\u0439 \u0421\u043E\u0432\u0435\u0442\u0441\u043A\u043E\u0433\u043E
    \u0421\u043E\u044E\u0437\u0430. \u0420\u043E\u0434\u0438\u043B\u0441\u044F 27
    \u0438\u044E\u043B\u044F 1946 \u0433\u043E\u0434\u0430 \u0432 \u041A\u0430\u0440\u0430\u0433\u0430\u043D\u0434\u0438\u043D\u0441\u043A\u043E\u0439
    \u043E\u0431\u043B\u0430\u0441\u0442\u0438. \u0414\u043E \u043F\u043E\u043B\u0451\u0442\u0430
    \u0432 \u043A\u043E\u0441\u043C\u043E\u0441 \u0440\u0430\u0431\u043E\u0442\u0430\u043B
    \u043B\u0451\u0442\u0447\u0438\u043A\u043E\u043C-\u0438\u0441\u043F\u044B\u0442\u0430\u0442\u0435\u043B\u0435\u043C
    \u0438 \u043E\u0441\u0432\u043E\u0438\u043B \u0431\u043E\u043B\u0435\u0435 50
    \u0442\u0438\u043F\u043E\u0432 \u0441\u0430\u043C\u043E\u043B\u0451\u0442\u043E\u0432.
    2 \u043E\u043A\u0442\u044F\u0431\u0440\u044F 1991 \u0433\u043E\u0434\u0430 \u0441\u043E\u0432\u0435\u0440\u0448\u0438\u043B
    \u043F\u043E\u043B\u0451\u0442 \u043D\u0430 \u043A\u043E\u0441\u043C\u0438\u0447\u0435\u0441\u043A\u043E\u043C
    \u043A\u043E\u0440\u0430\u0431\u043B\u0435 \xAB\u0421\u043E\u044E\u0437 \u0422\u041C-13\xBB
    \u043A \u043E\u0440\u0431\u0438\u0442\u0430\u043B\u044C\u043D\u043E\u0439 \u0441\u0442\u0430\u043D\u0446\u0438\u0438
    \xAB\u041C\u0438\u0440\xBB, \u0433\u0434\u0435 \u043F\u0440\u043E\u0432\u0451\u043B
    \u043F\u043E\u0447\u0442\u0438 8 \u0441\u0443\u0442\u043E\u043A, \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u044F
    \u043D\u0430\u0443\u0447\u043D\u044B\u0435 \u044D\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442\u044B.
    \u041F\u043E\u0441\u043B\u0435 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u044F
    \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u043B \u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u0443\u044E
    \u0438 \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u0443\u044E
    \u0434\u0435\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C, \u0441\u0442\u0430\u0432
    \u043E\u0434\u043D\u043E\u0439 \u0438\u0437 \u0441\u0430\u043C\u044B\u0445 \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0445
    \u043B\u0438\u0447\u043D\u043E\u0441\u0442\u0435\u0439 \u0432 \u0438\u0441\u0442\u043E\u0440\u0438\u0438
    \u043A\u043E\u0441\u043C\u043E\u043D\u0430\u0432\u0442\u0438\u043A\u0438 \u041A\u0430\u0437\u0430\u0445\u0441\u0442\u0430\u043D\u0430."
