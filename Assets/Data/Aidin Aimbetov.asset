  m_Script: {fileID: 11500000, guid: c18a09a6f4a745c4f98a5e972119e6a5, type: 3}
  m_Name: Aidin Aimbetov
  m_EditorClassIdentifier: Assembly-CSharp::Information
  text: "\u0410\u0439\u0434\u044B\u043D \u0410\u0439\u044B\u043C\u0431\u0435\u0442\u043E\u0432
    \u2014 \u043A\u0430\u0437\u0430\u0445\u0441\u0442\u0430\u043D\u0441\u043A\u0438\u0439
    \u043A\u043E\u0441\u043C\u043E\u043D\u0430\u0432\u0442, \u0432\u043E\u0435\u043D\u043D\u044B\u0439
    \u043B\u0451\u0442\u0447\u0438\u043A \u0438 \u0433\u0435\u043D\u0435\u0440\u0430\u043B-\u043C\u0430\u0439\u043E\u0440
    \u0412\u0412\u0421 \u041A\u0430\u0437\u0430\u0445\u0441\u0442\u0430\u043D\u0430.
    \u0420\u043E\u0434\u0438\u043B\u0441\u044F 27 \u0438\u044E\u043B\u044F 1972 \u0433\u043E\u0434\u0430
    \u0432 \u0422\u0430\u043B\u0434\u044B\u043A\u043E\u0440\u0433\u0430\u043D\u0441\u043A\u043E\u0439
    \u043E\u0431\u043B\u0430\u0441\u0442\u0438. \u0421\u043E 2 \u043F\u043E 12 \u0441\u0435\u043D\u0442\u044F\u0431\u0440\u044F
    2015 \u0433\u043E\u0434\u0430 \u0441\u043E\u0432\u0435\u0440\u0448\u0438\u043B
    \u043F\u043E\u043B\u0451\u0442 \u043D\u0430 \u043A\u043E\u0441\u043C\u0438\u0447\u0435\u0441\u043A\u043E\u043C
    \u043A\u043E\u0440\u0430\u0431\u043B\u0435 \xAB\u0421\u043E\u044E\u0437 \u0422\u041C\u0410-18\u041C\xBB
    \u043A \u041C\u0435\u0436\u0434\u0443\u043D\u0430\u0440\u043E\u0434\u043D\u043E\u0439
    \u043A\u043E\u0441\u043C\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u0441\u0442\u0430\u043D\u0446\u0438\u0438,
    \u043F\u0440\u043E\u0432\u0435\u0434\u044F \u0432 \u043A\u043E\u0441\u043C\u043E\u0441\u0435
    \u043F\u043E\u0447\u0442\u0438 10 \u0441\u0443\u0442\u043E\u043A. \u0417\u0430
    \u0432\u043A\u043B\u0430\u0434 \u0432 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435
    \u043A\u043E\u0441\u043C\u043E\u043D\u0430\u0432\u0442\u0438\u043A\u0438 \u043E\u043D
    \u0443\u0434\u043E\u0441\u0442\u043E\u0435\u043D \u0437\u0432\u0430\u043D\u0438\u044F
    \xAB\u041D\u0430\u0440\u043E\u0434\u043D\u044B\u0439 \u0413\u0435\u0440\u043E\u0439
    \u041A\u0430\u0437\u0430\u0445\u0441\u0442\u0430\u043D\u0430\xBB \u0438 \u0437\u0432\u0430\u043D\u0438\u044F
    \xAB\u041B\u0451\u0442\u0447\u0438\u043A-\u043A\u043E\u0441\u043C\u043E\u043D\u0430\u0432\u0442
    \u041A\u0430\u0437\u0430\u0445\u0441\u0442\u0430\u043D\u0430\xBB. \u041F\u043E\u0441\u043B\u0435
    \u043F\u043E\u043B\u0451\u0442\u0430 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u043B
    \u0440\u0430\u0431\u043E\u0442\u0443 \u0432 \u043A\u043E\u0441\u043C\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u043E\u0442\u0440\u0430\u0441\u043B\u0438 \u041A\u0430\u0437\u0430\u0445\u0441\u0442\u0430\u043D\u0430
    \u043D\u0430 \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u044F\u0449\u0438\u0445
    \u0434\u043E\u043B\u0436\u043D\u043E\u0441\u0442\u044F\u0445."
